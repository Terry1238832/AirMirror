          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選擇的視窗目前不可用，請刷新後重新選擇。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected window is currently unavailable, please refresh and select again."
          }
        },
        "ja": {
