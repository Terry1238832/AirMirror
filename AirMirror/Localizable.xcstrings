    "还没有可截取的投屏画面，请先连接 iPhone / iPad。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可截取的投屏画面，请先连接 iPhone / iPad。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有可截取的投影畫面，請先連接 iPhone / iPad。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no screenshot to capture, please connect your iPhone / iPad first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャするスクリーンショットはありません。最初に iPhone / iPad を接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡쳐할 스크린샷이 없습니다. 먼저 iPhone/iPad를 연결해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de capture d'écran à capturer, veuillez d'abord connecter votre iPhone/iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Screenshot zum Aufnehmen vorhanden. Bitte schließen Sie zuerst Ihr iPhone/iPad an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna captura de pantalla para capturar, primero conecte su iPhone/iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há captura de tela para capturar, conecte seu iPhone/iPad primeiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è necessario acquisire screenshot, collega prima il tuo iPhone/iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скриншот для снимка отсутствует. Сначала подключите iPhone/iPad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لقطة شاشة لالتقاطها، يرجى توصيل جهاز iPhone / iPad الخاص بك أولاً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर करने के लिए कोई स्क्रीनशॉट नहीं है, कृपया पहले अपना iPhone/iPad कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्चर करने के लिए कोई स्क्रीनशॉट नहीं है, कृपया पहले अपना iPhone/iPad कनेक्ट करें।"
          }
        }
      }
    },
