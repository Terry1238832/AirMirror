    "没有找到 %1$@ 的窗口。请确认软件已打开，再点刷新。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到 %1$@ 的窗口。请确认软件已打开，再点刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有找到 %1$@ 的窗口。請確認軟體已打開，再點刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No window found for %1$@. Please confirm that the software is open and then click Refresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のウィンドウが見つかりません。ソフトウェアが開いていることを確認し、[更新]をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 대한 창을 찾을 수 없습니다. 소프트웨어가 열려 있는지 확인한 다음 새로 고침을 클릭하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune fenêtre trouvée pour %1$@. Veuillez confirmer que le logiciel est ouvert, puis cliquez sur Actualiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %1$@ wurde kein Fenster gefunden. Bitte bestätigen Sie, dass die Software geöffnet ist, und klicken Sie dann auf Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna ventana para %1$@. Confirme que el software esté abierto y luego haga clic en Actualizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma janela encontrada para %1$@. Confirme se o software está aberto e clique em Atualizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna finestra trovata per %1$@. Confermare che il software sia aperto e quindi fare clic su Aggiorna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна для %1$@ не найдены. Пожалуйста, подтвердите, что программное обеспечение открыто, и нажмите «Обновить»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على نافذة لـ %1$@. الرجاء التأكد من أن البرنامج مفتوح، ثم انقر فوق تحديث."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ के लिए कोई विंडो नहीं मिली. कृपया पुष्टि करें कि सॉफ़्टवेयर खुला है और फिर ताज़ा करें पर क्लिक करें।"
          }
        },
        "id": {
