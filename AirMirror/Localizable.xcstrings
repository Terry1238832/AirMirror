        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المجموعة سوف تغلق النافذة، يرجى تغييرها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संयोजन विंडो बंद कर देगा, कृपया इसे बदलें।"
          }
        },
