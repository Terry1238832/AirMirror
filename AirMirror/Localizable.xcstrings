    "拖动滑块把画面调窄或调宽。窗口仍然只能放大或缩小。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块把画面调窄或调宽。窗口仍然只能放大或缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳滑桿把畫面調窄或調寬。視窗仍然只能放大或縮小。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the slider to make the screen narrower or wider. The window can still only be enlarged or reduced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライダーをドラッグして画像を狭くしたり広くしたりします。ウィンドウは引き続き拡大または縮小のみ可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이더를 끌어 화면을 더 좁거나 넓게 만듭니다. 창은 여전히 ​​확대 또는 축소만 가능합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le curseur pour rendre l'image plus étroite ou plus large. La fenêtre ne peut toujours être agrandie ou réduite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie den Schieberegler, um den Bildschirm schmaler oder breiter zu machen. Das Fenster kann weiterhin nur vergrößert oder verkleinert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre el control deslizante para estrechar o ampliar la imagen. La ventana todavía sólo se puede ampliar o reducir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o controle deslizante para tornar a imagem mais estreita ou mais larga. A janela ainda só pode ser ampliada ou reduzida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il cursore per restringere o allargare l'immagine. La finestra può ancora essere solo ingrandita o ridotta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите ползунок, чтобы сделать экран уже или шире. Окно по-прежнему можно только увеличивать или уменьшать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب شريط التمرير لجعل الصورة أضيق أو أوسع. لا يزال من الممكن تكبير النافذة أو تصغيرها فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन को संकरा या चौड़ा करने के लिए स्लाइडर को खींचें। विंडो को अभी भी केवल बड़ा या छोटा किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि को संकरा या चौड़ा बनाने के लिए स्लाइडर को खींचें। विंडो को अभी भी केवल बड़ा या छोटा किया जा सकता है।"
          }
        }
      }
    },
    "按下 %1$@ 复制目标窗口截图，再按 ⌘V 粘贴": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 %1$@ 复制目标窗口截图，再按 ⌘V 粘贴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 %1$@ 複製目標視窗截圖，再按 ⌘V 貼上"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %1$@ to copy the screenshot of the target window, and then press ⌘V to paste"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を押してターゲット ウィンドウのスクリーンショットをコピーし、⌘V を押して貼り付けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@를 눌러 대상 창의 스크린샷을 복사한 다음 ⌘V를 눌러 붙여넣습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %1$@ pour copier la capture d'écran de la fenêtre cible, puis appuyez sur ⌘V pour coller"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie %1$@, um den Screenshot des Zielfensters zu kopieren, und drücken Sie dann ⌘V zum Einfügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione %1$@ para copiar la captura de pantalla de la ventana de destino y luego presione ⌘V para pegar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %1$@ para copiar a captura de tela da janela de destino e pressione ⌘V para colar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %1$@ per copiare lo screenshot della finestra di destinazione, quindi premi ⌘V per incollarlo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %1$@, чтобы скопировать снимок экрана целевого окна, а затем нажмите ⌘V, чтобы вставить его."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على %1$@ لنسخ لقطة الشاشة للنافذة المستهدفة، ثم اضغط على ⌘V للصقها"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य विंडो के स्क्रीनशॉट को कॉपी करने के लिए %1$@ दबाएँ, और फिर पेस्ट करने के लिए ⌘V दबाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य विंडो के स्क्रीनशॉट को कॉपी करने के लिए %1$@ दबाएँ, और फिर पेस्ट करने के लिए ⌘V दबाएँ"
          }
        }
      }
    },
