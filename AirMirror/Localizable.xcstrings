    "这个组合会关闭窗口，请换一个": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个组合会关闭窗口，请换一个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個組合會關閉窗口，請換一個"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This combination will close the window, please change it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この組み合わせではウィンドウが閉じますので、変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조합을 누르면 창이 닫힙니다. 변경해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette combinaison fermera la fenêtre, veuillez la modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kombination schließt das Fenster, bitte ändern Sie es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinación cerrará la ventana, cámbiela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta combinação fechará a janela, altere-a."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa combinazione chiuderà la finestra, per favore cambiala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта комбинация закроет окно, измените ее."
