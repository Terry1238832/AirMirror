    "点右边按钮后按下新组合。默认是 Command+·": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右边按钮后按下新组合。默认是 Command+·"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點右邊按鈕後按下新組合。預設是 Command+·"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the right button and press New Combination. The default is Command+·"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右ボタンをクリックして新しい組み合わせを押します。デフォルトはコマンド+・です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 버튼을 클릭하고 새로운 조합을 누르세요. 기본값은 Command+·입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton droit et appuyez sur Nouvelle combinaison. La valeur par défaut est Commande+·"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie mit der rechten Maustaste und drücken Sie „Neue Kombination“. Die Standardeinstellung ist Befehl+·"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic en el botón derecho y presione Nueva combinación. El valor predeterminado es Comando+·"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito e pressione Nova Combinação. O padrão é Command+·"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic con il pulsante destro e premere la nuova combinazione. L'impostazione predefinita è Comando+·"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите правую кнопку и нажмите «Новая комбинация». По умолчанию используется Command+·."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق الزر الأيمن واضغط على المجموعة الجديدة. الافتراضي هو Command+·"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएँ बटन पर क्लिक करें और नया संयोजन दबाएँ। डिफ़ॉल्ट Command+· है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएँ बटन पर क्लिक करें और नया संयोजन दबाएँ। डिफ़ॉल्ट Command+· है"
          }
        }
      }
    },
    "点按后按下新的组合键。和系统或其他软件冲突时不会保存。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按后按下新的组合键。和系统或其他软件冲突时不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按後按下新的組合鍵。和系統或其他軟體衝突時不會儲存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click and press a new key combination. It will not be saved if it conflicts with the system or other software."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックした後、新しいキーの組み合わせを押します。システムや他のソフトウェアと競合する場合は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 키 조합을 클릭하고 누르세요. 시스템이나 다른 소프트웨어와 충돌하는 경우 저장되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez puis appuyez sur une nouvelle combinaison de touches. Il ne sera pas enregistré en cas de conflit avec le système ou un autre logiciel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie und drücken Sie eine neue Tastenkombination. Es wird nicht gespeichert, wenn es zu Konflikten mit dem System oder anderer Software kommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic y presione una nueva combinación de teclas. No se guardará si entra en conflicto con el sistema u otro software."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma nova combinação de teclas após clicar. Ele não será salvo se entrar em conflito com o sistema ou outro software."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premere una nuova combinazione di tasti dopo aver fatto clic. Non verrà salvato se è in conflitto con il sistema o altro software."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и нажмите новую комбинацию клавиш. Он не будет сохранен, если конфликтует с системой или другим программным обеспечением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مجموعة مفاتيح جديدة بعد النقر. ولن يتم حفظه إذا كان يتعارض مع النظام أو البرامج الأخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिक करने के बाद एक नया कुंजी संयोजन दबाएँ। यदि यह सिस्टम या अन्य सॉफ़्टवेयर के साथ विरोध करता है तो इसे सहेजा नहीं जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नया कुंजी संयोजन क्लिक करें और दबाएँ। यदि यह सिस्टम या अन्य सॉफ़्टवेयर के साथ विरोध करता है तो इसे सहेजा नहीं जाएगा।"
          }
        }
      }
    },
