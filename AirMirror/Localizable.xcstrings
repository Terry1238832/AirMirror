    "最高画质，按设备能力协商分辨率": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高画质，按设备能力协商分辨率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最高畫質，依裝置能力協商分辨率"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum quality, at the resolution supported by your device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが対応する解像度で、最高の画質を使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최고의 이미지 품질, 장치 성능에 따라 해상도 협상"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualité d'image la plus élevée, négociez la résolution en fonction des capacités de l'appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchste Bildqualität, Auflösung entsprechend den Gerätefunktionen aushandeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máxima calidad de imagen, negocie la resolución según las capacidades del dispositivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mais alta qualidade de imagem, negocie a resolução de acordo com as capacidades do dispositivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massima qualità dell'immagine, negozia la risoluzione in base alle capacità del dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высочайшее качество изображения, разрешение согласовывается в зависимости от возможностей устройства"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى جودة للصورة، وتفاوض بشأن الدقة وفقًا لإمكانيات الجهاز"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्चतम छवि गुणवत्ता, डिवाइस क्षमताओं के अनुसार रिज़ॉल्यूशन पर बातचीत करें"
          }
        },
        "id": {
