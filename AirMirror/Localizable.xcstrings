    "如果有多个窗口，在下面点选要截取的那个": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有多个窗口，在下面点选要截取的那个"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
