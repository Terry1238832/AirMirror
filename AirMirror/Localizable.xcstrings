    "使用支持数据传输的 USB-C 或 Lightning 线，无需连接同一个 Wi-Fi。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用支持数据传输的 USB-C 或 Lightning 线，无需连接同一个 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用支援資料傳輸的 USB-C 或 Lightning 線，無需連接同一個 Wi-Fi。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a USB-C or Lightning cable that supports data transfer. A shared Wi-Fi network is not required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Wi-Fi に接続せずにデータ転送をサポートする USB-C または Lightning ケーブルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 Wi-Fi에 연결하지 않고도 데이터 전송을 지원하는 USB-C 또는 Lightning 케이블을 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un câble USB-C ou Lightning prenant en charge le transfert de données sans être connecté au même Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein USB-C- oder Lightning-Kabel, das die Datenübertragung unterstützt, ohne mit demselben WLAN verbunden zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice un cable USB-C o Lightning que admita la transferencia de datos sin estar conectado al mismo Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um cabo USB-C ou Lightning que suporte transferência de dados sem estar conectado ao mesmo Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza un cavo USB-C o Lightning che supporti il ​​trasferimento dati senza essere connesso allo stesso Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте кабель USB-C или Lightning, поддерживающий передачу данных, без подключения к той же сети Wi-Fi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم كابل USB-C أو Lightning الذي يدعم نقل البيانات دون الاتصال بنفس شبكة Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक यूएसबी-सी या लाइटनिंग केबल का उपयोग करें जो एक ही वाई-फाई से कनेक्ट किए बिना डेटा ट्रांसफर का समर्थन करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एक यूएसबी-सी या लाइटनिंग केबल का उपयोग करें जो एक ही वाई-फाई से कनेक्ट किए बिना डेटा ट्रांसफर का समर्थन करता है।"
          }
        }
      }
    },
    "保持镜投投屏中，或选择其他要截取的软件和窗口": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持镜投投屏中，或选择其他要截取的软件和窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
