    "1080p，画质和延迟折中": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p，画质和延迟折中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p，畫質與延遲摺中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p, balanced quality and latency"
          }
        },
        "ja": {
