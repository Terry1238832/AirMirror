    "把光标放到聊天框、文档等要插入图片的位置，按下 %1$@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把光标放到聊天框、文档等要插入图片的位置，按下 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把遊標放到聊天框、文件等要插入圖片的位置，按 %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the cursor in the chat box, document, etc. where you want to insert the image, and press %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットボックスや文書など、画像を挿入したい場所にカーソルを置き、%1$@を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 삽입하고 싶은 채팅창, 문서 등의 위치에 커서를 놓고 %1$@를 누르세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le curseur dans la boîte de discussion, le document, etc. où vous souhaitez insérer l'image, et appuyez sur %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie den Cursor in der Chatbox, im Dokument usw. an der Stelle, an der Sie das Bild einfügen möchten, und drücken Sie %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque el cursor en el cuadro de chat, documento, etc. donde desea insertar la imagen y presione %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
