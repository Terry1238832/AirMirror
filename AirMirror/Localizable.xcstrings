    "需要屏幕录制权限后，才能列出各个窗口。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要屏幕录制权限后，才能列出各个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要螢幕錄影權限後，才能列出各個視窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen recording permission is required before individual windows can be listed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個々のウィンドウを一覧表示するには、画面録画の許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개별 창을 나열하려면 화면 녹화 권한이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation d'enregistrement d'écran est requise avant que des fenêtres individuelles puissent être répertoriées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor einzelne Fenster aufgelistet werden können, ist eine Erlaubnis zur Bildschirmaufzeichnung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de grabación de pantalla antes de poder enumerar ventanas individuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de gravação de tela é necessária antes que janelas individuais possam ser listadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessaria l'autorizzazione alla registrazione dello schermo prima di poter elencare le singole finestre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отображения отдельных окон требуется разрешение на запись экрана."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن تسجيل الشاشة قبل أن يتم إدراج النوافذ الفردية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग विंडो को सूचीबद्ध करने से पहले स्क्रीन रिकॉर्डिंग की अनुमति आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग विंडो को सूचीबद्ध करने से पहले स्क्रीन रिकॉर्डिंग की अनुमति आवश्यक है।"
          }
        }
      }
    },
    "需要麦克风权限，用于接收数据线传来的设备声音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麦克风权限，用于接收数据线传来的设备声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要麥克風權限，用於接收資料線傳來的裝置聲音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is required to receive device sound from the data cable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ ケーブルからデバイスの音声を受信するには、マイクの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 라인에서 기기 사운드를 수신하려면 마이크 권한이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation du microphone est requise pour recevoir le son de l'appareil de la ligne de données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Empfang des Gerätetons über das Datenkabel ist eine Mikrofonberechtigung erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso del micrófono para recibir el sonido del dispositivo desde el cable de datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária permissão do microfone para receber o som do dispositivo a partir do cabo de dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere l'audio del dispositivo dal cavo dati è necessaria l'autorizzazione del microfono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для приема звука устройства по линии передачи данных требуется разрешение микрофона."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن الميكروفون لتلقي صوت الجهاز من كابل البيانات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा लाइन से डिवाइस ध्वनि प्राप्त करने के लिए माइक्रोफ़ोन की अनुमति आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा केबल से डिवाइस ध्वनि प्राप्त करने के लिए माइक्रोफ़ोन की अनुमति आवश्यक है।"
          }
        }
      }
    },
