    "应用内的无线接收引擎缺失，请重新安装镜投。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内的无线接收引擎缺失，请重新安装镜投。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用內的無線接收引擎缺失，請重新安裝鏡投。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wireless receiving engine in the application is missing, please reinstall AirMirror."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションにワイヤレス受信エンジンがありません。AirMirror を再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램의 무선 수신 엔진이 없습니다. AirMirror를 다시 설치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de réception sans fil de l'application est manquant, veuillez réinstaller AirMirror."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drahtlose Empfangs-Engine in der Anwendung fehlt. Bitte installieren Sie AirMirror neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el motor de recepción inalámbrica en la aplicación; reinstale AirMirror."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de recepção sem fio no aplicativo está faltando. Reinstale o AirMirror."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca il motore di ricezione wireless nell'applicazione, reinstalla AirMirror."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Механизм беспроводного приема в приложении отсутствует, переустановите AirMirror."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرك الاستقبال اللاسلكي في التطبيق مفقود، يرجى إعادة تثبيت AirMirror."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एप्लिकेशन में वायरलेस रिसीविंग इंजन गायब है, कृपया एयरमिरर को पुनः इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एप्लिकेशन में वायरलेस रिसीविंग इंजन गायब है, कृपया एयरमिरर को पुनः इंस्टॉल करें।"
          }
        }
      }
    },
    "应用内的无线接收组件不完整，请重新安装镜投。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内的无线接收组件不完整，请重新安装镜投。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用內的無線接收元件不完整，請重新安裝鏡投。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wireless receiving component in the application is incomplete, please reinstall AirMirror."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションのワイヤレス受信コンポーネントが不完全です。AirMirror を再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램의 무선 수신 구성 요소가 불완전합니다. AirMirror를 다시 설치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le composant de réception sans fil dans l'application est incomplet, veuillez réinstaller AirMirror."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drahtlose Empfangskomponente in der Anwendung ist unvollständig. Bitte installieren Sie AirMirror neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El componente de recepción inalámbrica en la aplicación está incompleto; reinstale AirMirror."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O componente de recepção sem fio no aplicativo está incompleto, reinstale o AirMirror."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il componente di ricezione wireless nell'applicazione è incompleto, reinstalla AirMirror."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компонент беспроводного приема в приложении неполный, переустановите AirMirror."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكون الاستقبال اللاسلكي في التطبيق غير مكتمل، يرجى إعادة تثبيت AirMirror."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एप्लिकेशन में वायरलेस रिसीविंग घटक अधूरा है, कृपया AirMirror को पुनः इंस्टॉल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एप्लिकेशन में वायरलेस रिसीविंग घटक अधूरा है, कृपया AirMirror को पुनः इंस्टॉल करें।"
          }
        }
      }
    },
    "开启「播放设备声音」后，镜投需要音频采集权限来播放 USB 连接的 iPhone 或 iPad 的声音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启「播放设备声音」后，镜投需要音频采集权限来播放 USB 连接的 iPhone 或 iPad 的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「播放裝置聲音」後，鏡投需要音訊擷取權限來播放 USB 連接的 iPhone 或 iPad 的聲音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After turning on \"Play Device Sound\", AirMirror requires audio collection permission to play the sound of the USB-connected iPhone or iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デバイスサウンドの再生」をオンにした後、AirMirror は USB 接続された iPhone または iPad のサウンドを再生するためにオーディオ収集の許可を必要とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror는 \"장치 사운드 재생\"을 켠 후 USB로 연결된 iPhone 또는 iPad의 사운드를 재생하려면 오디오 수집 권한이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir activé « Lire le son de l'appareil », AirMirror nécessite l'autorisation de collecte audio pour lire le son d'un iPhone ou d'un iPad connecté par USB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Aktivieren von „Geräteton abspielen“ benötigt AirMirror die Berechtigung zur Audiosammlung, um den Ton eines über USB angeschlossenen iPhones oder iPads abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de activar \"Reproducir sonido del dispositivo\", AirMirror requiere permiso de recopilación de audio para reproducir el sonido de un iPhone o iPad conectado por USB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de ativar \"Reproduzir som do dispositivo\", o AirMirror requer permissão de coleta de áudio para reproduzir o som de um iPhone ou iPad conectado por USB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver attivato \"Riproduci audio dispositivo\", AirMirror richiede l'autorizzazione alla raccolta audio per riprodurre l'audio dell'iPhone o iPad collegato tramite USB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После включения «Воспроизвести звук устройства» AirMirror требует разрешения на сбор аудио для воспроизведения звука iPhone или iPad, подключенного через USB."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تشغيل \"تشغيل صوت الجهاز\"، يتطلب AirMirror إذنًا لجمع الصوت لتشغيل صوت جهاز iPhone أو iPad المتصل عبر USB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"प्ले डिवाइस साउंड\" चालू करने के बाद, एयरमिरर को यूएसबी-कनेक्टेड आईफोन या आईपैड की ध्वनि चलाने के लिए ऑडियो संग्रह अनुमति की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"प्ले डिवाइस साउंड\" चालू करने के बाद, एयरमिरर को यूएसबी-कनेक्टेड आईफोन या आईपैड की ध्वनि चलाने के लिए ऑडियो संग्रह अनुमति की आवश्यकता होती है।"
          }
        }
      }
    },
    "开启时需要麦克风权限，用于接收数据线传来的设备声音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时需要麦克风权限，用于接收数据线传来的设备声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時需要麥克風權限，用於接收資料線傳來的裝置聲音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is required when turned on, which is used to receive the device sound from the data cable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにするとマイクの許可が必要になります。これは、データ ケーブルからデバイスの音声を受信するために使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 라인에서 기기 사운드를 수신하기 위해 사용되는 마이크 권한이 켜질 때 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation du microphone est requise lorsqu'il est allumé, qui est utilisé pour recevoir le son de l'appareil de la ligne de données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einschalten ist eine Mikrofonberechtigung erforderlich, die zum Empfang des Gerätetons über das Datenkabel verwendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso del micrófono cuando está encendido, que se utiliza para recibir el sonido del dispositivo desde el cable de datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ligado, é necessária a permissão do microfone, que é usado para receber o som do dispositivo da linha de dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è acceso è necessaria l'autorizzazione del microfono, che viene utilizzato per ricevere l'audio del dispositivo dal cavo dati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении требуется разрешение микрофона, которое используется для приема звука устройства по линии передачи данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن الميكروفون عند تشغيله، والذي يستخدم لاستقبال صوت الجهاز من كابل البيانات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर माइक्रोफ़ोन अनुमति की आवश्यकता होती है, जिसका उपयोग डेटा लाइन से डिवाइस ध्वनि प्राप्त करने के लिए किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर माइक्रोफ़ोन अनुमति की आवश्यकता होती है, जिसका उपयोग डेटा केबल से डिवाइस ध्वनि प्राप्त करने के लिए किया जाता है।"
          }
        }
      }
    },
