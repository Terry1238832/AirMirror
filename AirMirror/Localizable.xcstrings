        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع المؤشر في مربع الدردشة أو المستند أو ما إلى ذلك حيث تريد إدراج الصورة ثم اضغط %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कर्सर को चैट बॉक्स, दस्तावेज़ आदि में रखें जहाँ आप छवि डालना चाहते हैं, और %1$@ दबाएँ"
