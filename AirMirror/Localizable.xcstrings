          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror 미러링을 유지하거나 캡처할 다른 소프트웨어 및 창을 선택하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la mise en miroir d'AirMirror ou sélectionnez d'autres logiciels et fenêtres à capturer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die Spiegelung mit AirMirror bei oder wählen Sie andere Software und Fenster zum Aufzeichnen aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la duplicación de AirMirror o seleccione otro software y ventanas para capturar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o espelhamento do AirMirror ou selecione outro software e janelas para capturar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il mirroring AirMirror o seleziona altri software e finestre da acquisire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте зеркалирование AirMirror или выберите другое программное обеспечение и окна для захвата"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على انعكاس AirMirror، أو حدد برامج ونوافذ أخرى لالتقاطها"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror को मिरर करते रहें, या कैप्चर करने के लिए अन्य सॉफ़्टवेयर और विंडोज़ का चयन करें"
