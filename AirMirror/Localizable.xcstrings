        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p, गुणवत्ता और विलंबता का आदान-प्रदान"
          }
        }
      }
    },
    "720p，延迟最低，适合跟手操作": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "720p，延迟最低，适合跟手操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "720p，延遲最低，適合跟上操作"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, lowest latency for responsive control"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "720p、遅延が最も低く、実践的な操作に適しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, 최저 대기 시간, 실습에 적합"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, latence la plus faible, adapté à une utilisation pratique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, niedrigste Latenz, geeignet für die praktische Bedienung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, latencia más baja, adecuado para operación práctica"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, latência mais baixa, adequado para operação prática"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, latenza più bassa, adatta per operazioni pratiche"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, минимальная задержка, подходит для ручного управления"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "720 بكسل، أقل زمن وصول، مناسب للتشغيل العملي"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, न्यूनतम विलंबता, व्यावहारिक संचालन के लिए उपयुक्त"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "720p, न्यूनतम विलंबता, व्यावहारिक संचालन के लिए उपयुक्त"
          }
        }
      }
