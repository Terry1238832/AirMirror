    "还没有投屏引擎。请先运行 AirMirror/build.sh 完成安装。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有投屏引擎。请先运行 AirMirror/build.sh 完成安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有投影引擎。請先執行 AirMirror/build.sh 完成安裝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no screencasting engine yet. Please run AirMirror/build.sh first to complete the installation."
          }
        },
        "ja": {
          "stringUnit": {
