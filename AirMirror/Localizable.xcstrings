          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the window to capture below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のウィンドウがある場合は、以下でインターセプトするウィンドウをクリックします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창이 여러 개인 경우 아래에서 가로채고 싶은 창을 클릭하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il y a plusieurs fenêtres, cliquez ci-dessous sur celle que vous souhaitez intercepter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
