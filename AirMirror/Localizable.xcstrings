    "窗口只能放大或缩小，投屏比例保持不变。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口只能放大或缩小，投屏比例保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗只能放大或縮小，投影比例保持不變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window can only be enlarged or reduced, and the projection screen ratio remains unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウは拡大または縮小のみ可能で、投写画面の比率は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창은 확대 또는 축소만 가능하며 투사 화면 비율은 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre peut uniquement être agrandie ou réduite, et le rapport de l'écran de projection reste inchangé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster kann nur vergrößert oder verkleinert werden, das Projektionsflächenverhältnis bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana sólo se puede ampliar o reducir y la proporción de la pantalla de proyección permanece sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela só pode ser ampliada ou reduzida e a proporção da tela de projeção permanece inalterada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra può solo essere ingrandita o ridotta e il rapporto dello schermo di proiezione rimane invariato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно можно только увеличивать или уменьшать, а соотношение проекционного экрана остается неизменным."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلا تكبير النافذة أو تصغيرها، وتبقى نسبة شاشة العرض دون تغيير."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो को केवल बड़ा या छोटा किया जा सकता है, और प्रोजेक्शन स्क्रीन अनुपात अपरिवर्तित रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो को केवल बड़ा या छोटा किया जा सकता है, और प्रोजेक्शन स्क्रीन अनुपात अपरिवर्तित रहता है।"
          }
        }
      }
    },
