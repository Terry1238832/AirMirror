          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de privacidade do AirMirror\nÚltima atualização: 14 de novembro de 2026\nÂmbito de aplicação: AirMirror e seus recursos de acessibilidade integrados WindowPaste.\nDesenvolvedor: Liang Yu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informativa sulla privacy di AirMirror\nUltimo aggiornamento: 14 novembre 2026\nAmbito di applicazione: AirMirror e le sue funzionalità di accessibilità WindowPaste integrate.\nSviluppatore: Liang Yu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявление о конфиденциальности AirMirror\nПоследнее обновление: 14 ноября 2026 г.\nОбласть применения: AirMirror и его встроенные функции доступности WindowPaste.\nРазработчик: Лян Ю."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيان خصوصية AirMirror\nآخر تحديث: 14 نوفمبر 2026\nنطاق التطبيق: AirMirror وميزات إمكانية الوصول المضمنة في WindowPaste.\nالمطور: ليانغ يو."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एयरमिरर गोपनीयता कथन\nअंतिम अद्यतन: 14 नवंबर, 2026\nआवेदन का दायरा: एयरमिरर और इसकी अंतर्निहित विंडोपेस्ट एक्सेसिबिलिटी सुविधाएं।\nडेवलपर: लियांग यू."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एयरमिरर गोपनीयता निर्देश\nअंतिम अद्यतन: 14 नवंबर, 2026\nआवेदन का दायरा: एयरमिरर और इसकी अंतर्निहित विंडोपेस्ट एक्सेसिबिलिटी सुविधाएं।\nडेवलपर: लियांग यू."
          }
        }
      }
    },
    "镜投需要访问局域网，才能被 iPhone、iPad 用系统自带的「屏幕镜像」搜到并连接。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜投需要访问局域网，才能被 iPhone、iPad 用系统自带的「屏幕镜像」搜到并连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡投需要存取區域網，才能被 iPhone、iPad 用系統隨附的「螢幕鏡像」搜尋並連接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror needs to access the LAN before it can be discovered and connected by iPhone and iPad using the system's built-in \"Screen Mirroring\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror は、システム内蔵の「画面ミラーリング」を使用して iPhone および iPad によって検出され、接続される前に、LAN にアクセスする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror는 시스템에 내장된 \"스크린 미러링\"을 사용하여 iPhone 및 iPad에서 LAN을 찾고 연결하기 전에 LAN에 액세스해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror doit accéder au réseau local avant de pouvoir être découvert et connecté par iPhone et iPad à l'aide du « Screen Mirroring » intégré au système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror muss auf das LAN zugreifen, bevor es mithilfe der systemeigenen „Bildschirmspiegelung“ von iPhone und iPad erkannt und verbunden werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror necesita acceder a la LAN antes de que el iPhone y el iPad puedan descubrirlo y conectarlo mediante el \"Screen Mirroring\" integrado en el sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AirMirror precisa acessar a LAN antes que possa ser descoberto e conectado pelo iPhone e iPad usando o “Screen Mirroring” integrado do sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror deve accedere alla LAN prima di poter essere rilevato e connesso da iPhone e iPad utilizzando lo \"Screen Mirroring\" integrato nel sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror должен получить доступ к локальной сети, прежде чем его можно будет обнаружить и подключить iPhone и iPad с помощью встроенной функции «Зеркалирование экрана»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج AirMirror إلى الوصول إلى الشبكة المحلية (LAN) قبل أن يتم اكتشافه والاتصال به بواسطة iPhone وiPad باستخدام \"Screen Mirroring\" المدمج في النظام."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एयरमिरर को सिस्टम के अंतर्निहित \"स्क्रीन मिररिंग\" का उपयोग करके iPhone और iPad द्वारा खोजे और कनेक्ट करने से पहले LAN तक पहुंचने की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "एयरमिरर को सिस्टम की अंतर्निहित \"स्क्रीन मिररिंग\" का उपयोग करके iPhone और iPad द्वारा खोजे और कनेक्ट किए जाने से पहले LAN तक पहुंचने की आवश्यकता है।"
          }
        }
      }
    },
    "镜投需要通过 macOS 的相机采集接口，读取 USB 连接的 iPhone 或 iPad 屏幕画面。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜投需要通过 macOS 的相机采集接口，读取 USB 连接的 iPhone 或 iPad 屏幕画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡投需要透過 macOS 的相機擷取接口，讀取 USB 連接的 iPhone 或 iPad 螢幕畫面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror needs to read the USB-connected iPhone or iPad screen through the camera acquisition interface of macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror は、macOS のカメラ取得インターフェイスを通じて、USB 接続された iPhone または iPad の画面を読み取る必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror는 macOS의 카메라 인식 인터페이스를 통해 USB로 연결된 iPhone 또는 iPad 화면을 읽어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror doit lire l'écran de l'iPhone ou de l'iPad connecté par USB via l'interface d'acquisition de caméra de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror muss den über USB angeschlossenen iPhone- oder iPad-Bildschirm über die Kameraerfassungsschnittstelle von macOS lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror necesita leer la pantalla del iPhone o iPad conectado por USB a través de la interfaz de adquisición de la cámara de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AirMirror precisa ler a tela do iPhone ou iPad conectado por USB por meio da interface de aquisição de câmera do macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror deve leggere lo schermo dell'iPhone o dell'iPad collegato tramite USB tramite l'interfaccia di acquisizione della fotocamera di macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror необходимо считывать экран iPhone или iPad, подключенного через USB, через интерфейс захвата камеры macOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج AirMirror إلى قراءة شاشة iPhone أو iPad المتصلة عبر USB من خلال واجهة الحصول على الكاميرا في نظام التشغيل macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror को macOS के कैमरा अधिग्रहण इंटरफ़ेस के माध्यम से USB-कनेक्टेड iPhone या iPad स्क्रीन को पढ़ने की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AirMirror को macOS के कैमरा अधिग्रहण इंटरफ़ेस के माध्यम से USB-कनेक्टेड iPhone या iPad स्क्रीन को पढ़ने की आवश्यकता है।"
          }
        }
      }
    },
